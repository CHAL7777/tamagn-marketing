# --- Public (browser) — use HTTPS in production ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Dashboard → Project Settings → API)
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Server-only (never expose to client) ---
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Supabase CLI: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Hugging Face inference
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=google/flan-t5-base

# Optional: require header x-mpesa-callback-secret on POST /api/payments/mpesa-callback
MPESA_CALLBACK_SECRET=

# --- M-Pesa Kenya sandbox (Daraja) — https://developer.safaricom.co.ke ---
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_OAUTH_PATH=/oauth/v1/generate
MPESA_STK_PATH=/mpesa/stkpush/v1/processrequest
MPESA_B2C_PATH=/mpesa/b2c/v1/paymentrequest
MPESA_REVERSAL_PATH=/mpesa/reversal/v1/request
MPESA_MSISDN_COUNTRY_CODE=254
MPESA_STK_MERCHANT_REQUEST_PREFIX=Liger
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:3000/api/payments/mpesa-callback

# B2C payout (escrow release) — webhook routes must be implemented and publicly reachable in prod
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_PARTY_A=
MPESA_B2C_QUEUE_TIMEOUT_URL=http://localhost:3000/api/payments/mpesa-b2c-queue-timeout
MPESA_B2C_RESULT_URL=http://localhost:3000/api/payments/mpesa-b2c-result

# Reversal — webhook routes must be implemented and publicly reachable in prod
MPESA_REVERSAL_RESULT_URL=http://localhost:3000/api/payments/mpesa-reversal-result
MPESA_REVERSAL_QUEUE_TIMEOUT_URL=http://localhost:3000/api/payments/mpesa-reversal-queue-timeout
# Optional overrides (lib/mpesa.ts defaults shown in comments)
# MPESA_B2C_COMMAND_ID=BusinessPayment
# MPESA_REVERSAL_INITIATOR=
# MPESA_REVERSAL_SECURITY_CREDENTIAL=
# MPESA_REVERSAL_PARTY_A=
# MPESA_REVERSAL_RECEIVER_ID_TYPE=4

# Demo seed (optional) — all demo users will use this password if set.
DEMO_USER_PASSWORD=
# Login/signup: show “Local demo” panel. In next dev it shows by default; set "false" to hide. Set "true" to show in production builds (e.g. staging).
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=

# --- Ethiopia sandbox (uncomment and comment Kenya block above if using ET) ---
# MPESA_BASE_URL=https://apisandbox.safaricom.et
# MPESA_OAUTH_PATH=/v1/token/generate
# MPESA_STK_PATH=/mpesa/stkpush/v3/processrequest
# MPESA_MSISDN_COUNTRY_CODE=251
# MPESA_B2C_PATH=/mpesa/b2c/v2/paymentrequest
# MPESA_REVERSAL_PATH=/mpesa/reversal/v2/request
