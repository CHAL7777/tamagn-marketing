# --- Public (safe for browser) ---
# Canonical site URL for metadata, OG URLs, and sitemaps
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (never expose to client) ---
# Required for M-Pesa webhooks, admin mutations, escrow reconciliation
SUPABASE_SERVICE_ROLE_KEY=

# Optional: require this header on POST /api/payments/mpesa-callback
# MPESA_CALLBACK_SECRET=

# --- M-Pesa (see README for Kenya vs Ethiopia) ---
# MPESA_BASE_URL=
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=
# MPESA_MSISDN_COUNTRY_CODE=251
# MPESA_STK_PATH=
# MPESA_OAUTH_PATH=
# MPESA_STK_MERCHANT_REQUEST_PREFIX=

# B2C payout (escrow release)
# MPESA_INITIATOR_NAME=
# MPESA_SECURITY_CREDENTIAL=
# MPESA_B2C_PARTY_A=
# MPESA_B2C_QUEUE_TIMEOUT_URL=
# MPESA_B2C_RESULT_URL=
